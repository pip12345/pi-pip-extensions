{
  "name": "pi-webfetch-websearch",
  "version": "0.1.0",
  "description": "Minimal dependency-free web fetch and web search tools with bounded output for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "webfetch",
    "websearch",
    "search",
    "web"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "node_modules/pip-common/index.ts",
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/artifacts.ts",
    "src/entities.ts",
    "src/html.ts",
    "src/http.ts",
    "src/limits.ts",
    "src/mcp.ts",
    "src/settings.ts",
    "src/sites/github.ts",
    "src/tool-render.ts",
    "src/webfetch.ts",
    "src/websearch-format.ts",
    "src/websearch.ts",
    "README.md"
  ],
  "dependencies": {
    "pip-common": "0.1.0"
  },
  "bundledDependencies": [
    "pip-common"
  ]
}
