{
  "name": "pi-stats",
  "version": "0.1.0",
  "description": "Interactive /stats inspector with session and global usage views",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tokens",
    "usage",
    "tui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "node_modules/pip-common/index.ts",
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/usage/compaction.ts",
    "src/usage/compatibility.ts",
    "src/usage/daily.ts",
    "src/usage/events.ts",
    "src/usage/locks.ts",
    "src/usage/rollups.ts",
    "src/usage/storage.ts",
    "src/usage/types.ts",
    "README.md"
  ],
  "dependencies": {
    "pip-common": "0.1.0"
  },
  "bundledDependencies": [
    "pip-common"
  ]
}
