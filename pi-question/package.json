{
  "name": "pi-question",
  "version": "0.1.0",
  "description": "Interactive opencode-style question tool for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "question",
    "tui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "node_modules/pip-common/index.ts",
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/format.ts",
    "src/render.ts",
    "src/schema.ts",
    "src/state.ts",
    "src/tool.ts",
    "src/ui.ts",
    "README.md"
  ],
  "dependencies": {
    "pip-common": "0.1.0"
  },
  "bundledDependencies": [
    "pip-common"
  ]
}
