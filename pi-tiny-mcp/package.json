{
  "name": "pi-tiny-mcp",
  "version": "0.1.0",
  "description": "Tiny stdio/HTTP MCP adapter for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "stdio",
    "http",
    "tiny"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "node_modules/pip-common/index.ts",
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/artifacts.ts",
    "src/cache.ts",
    "src/config.ts",
    "src/editor.ts",
    "src/http.ts",
    "src/jsonrpc.ts",
    "src/manager.ts",
    "src/mcp-client.ts",
    "src/proxy-tool.ts",
    "src/settings.ts",
    "src/state.ts",
    "src/stdio.ts",
    "src/transport.ts",
    "src/types.ts",
    "README.md"
  ],
  "dependencies": {
    "pip-common": "0.1.0"
  },
  "bundledDependencies": [
    "pip-common"
  ]
}
