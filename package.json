{
  "name": "pi-pip-extensions",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "pip-common/index.ts",
      "pi-context/index.ts",
      "pi-pip-footer/index.ts",
      "pi-prompt-profiles/index.ts",
      "pi-provider-model-patches/index.ts",
      "pi-provider-proxy/index.ts",
      "pi-question/index.ts",
      "pi-secrets-guard/index.ts",
      "pi-stats/index.ts",
      "pi-subagents/index.ts",
      "pi-tiny-mcp/index.ts",
      "pi-todo/index.ts",
      "pi-tool-ui/index.ts",
      "pi-tree-edit/index.ts",
      "pi-undo-redo/index.ts",
      "pi-webfetch-websearch/index.ts"
    ]
  },
  "workspaces": [
    "pip-common",
    "pi-*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.1",
    "@earendil-works/pi-coding-agent": "0.80.1",
    "@earendil-works/pi-tui": "0.80.1",
    "@types/node": "^24.3.0",
    "typebox": "^1.1.24",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
