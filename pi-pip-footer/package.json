{
  "name": "pi-pip-footer",
  "version": "0.1.0",
  "description": "Pip footer with live token counter, context gauge, model status, and quota usage for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer",
    "tokens",
    "usage",
    "working-indicator",
    "tui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "pi": {
    "extensions": [
      "node_modules/pip-common/index.ts",
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/constants.ts",
    "src/context.ts",
    "src/git.ts",
    "src/layout.ts",
    "src/model.ts",
    "src/quota.ts",
    "src/session-context.ts",
    "src/settings.ts",
    "src/token/breakdown.ts",
    "src/token/controller.ts",
    "src/token/render.ts",
    "README.md"
  ],
  "dependencies": {
    "pip-common": "0.1.0"
  },
  "bundledDependencies": [
    "pip-common"
  ]
}
