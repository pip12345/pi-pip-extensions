{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "Minimal quiet subagent task runs for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "node_modules/pip-common/index.ts",
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/agents.ts",
    "src/bounds.ts",
    "src/child-runtime.ts",
    "src/context.ts",
    "src/manager.ts",
    "src/model-ref.ts",
    "src/persistence.ts",
    "src/render.ts",
    "src/runner.ts",
    "src/schema.ts",
    "src/settings.ts",
    "src/snapshot.ts",
    "src/types.ts",
    "src/view.ts",
    "README.md",
    "agents/explore.md",
    "agents/general.md"
  ],
  "dependencies": {
    "pip-common": "0.1.0"
  },
  "bundledDependencies": [
    "pip-common"
  ]
}
